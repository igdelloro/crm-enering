# Copia questo file in ".env.local" e inserisci i valori del tuo progetto Supabase.
# Li trovi su https://supabase.com -> il tuo progetto -> Settings -> API

# URL del progetto (es. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblica "anon" (è sicura da usare nel browser, protetta dalle policy RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
